server {
    listen 80;
    server_name savinggroup.mastercode.in;

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name savinggroup.mastercode.in;

    ssl_certificate /etc/letsencrypt/live/savinggroup.mastercode.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/savinggroup.mastercode.in/privkey.pem;

    root /var/www/Production/SavingGroup;
    index index.html;

    location / {
        # React client-side routing support
        try_files $uri /index.html;
    }

    # Optional: serve static assets more efficiently
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public";
    }
}
