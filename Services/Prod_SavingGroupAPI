server {
    listen 80;
    server_name savinggroupapi.mastercode.in;

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name savinggroupapi.mastercode.in;

 ssl_certificate /etc/letsencrypt/live/savinggroupapi.mastercode.in/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/savinggroupapi.mastercode.in/privkey.pem;

    location / {
        proxy_pass http://localhost:6002;  # Your API port
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
